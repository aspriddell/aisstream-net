<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <AssemblyName>aisstream-net</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>true</IsPackable>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <Title>AISStream.NET</Title>
        <PackageId>AISStream.NET</PackageId>
        <Authors>Albie Spriddell</Authors>
        <Description>A low-memory, high-performance library for receiving events from aisstream.io</Description>

        <PackageTags>aisstream websockets ais vessels positioning</PackageTags>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>

        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <RepositoryType>Git</RepositoryType>
        <RepositoryUrl>https://github.com/aspriddell/aisstream-net</RepositoryUrl>
        <PackageProjectUrl>https://github.com/aspriddell/aisstream-net</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' OR '$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="FastEnum" Version="2.0.6"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
        <PackageReference Include="System.Text.Json" Version="9.0.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="FastEnum" Version="2.0.6"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
        <PackageReference Include="System.Text.Json" Version="10.0.0" />
    </ItemGroup>

</Project>
